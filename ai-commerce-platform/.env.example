# ============================================================
# AI Commerce Platform — environment template
# Copy to .env and adjust. NEVER commit a real .env.
# ============================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_DB=commerce
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full SQLAlchemy URL (built from the above by default inside Docker).
# Override to point at an external DB if needed.
DATABASE_URL=postgresql+psycopg://commerce:commerce@db:5432/commerce

# --- Cache (Redis) ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Generate a strong value for production: `openssl rand -hex 32`
SECRET_KEY=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (comma-separated origins the frontend is served from) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Market / commerce ---
CURRENCY=EGP

# --- Drop-shipping agents ---
# assisted:   الوكيل يجهّز كل شيء والمشغّل يوافق وينفّذ الشراء (الافتراضي الآمن)
# simulation: تنفيذ آلي كامل بمراجع وهمية — للتجربة والعرض فقط، بلا مال حقيقي
# api:        تنفيذ آلي عبر APIs الموردين الرسمية (يتطلب حسابات شركاء + connectors)
AGENT_MODE=assisted
# الحد الأدنى لهامش الربح الإجمالي الذي يقبله وكيل التوريد (%)
MARGIN_MIN_PERCENT=15

# --- Payments ---
# cod: الدفع عند الاستلام (افتراضي، بلا تكلفة إعداد)
# gateway: بوابة إلكترونية — تتطلب adapter مفعّل (Paymob/Stripe) — انظر docs/launch.md
PAYMENT_PROVIDER=cod

# --- مورد دروب شيبينج رسمي بـ API (الأتمتة الكاملة الأسهل) ---
# أي مورد يوفّر REST API للطلبات. اتركها فارغة = الوكيل يبقى مساعَداً.
# ثم أنشئ مورداً بـ slug='api-dropship' وmode='api' واضبط AGENT_MODE=api.
DROPSHIP_API_BASE=
DROPSHIP_API_KEY=
DROPSHIP_API_AUTH_STYLE=bearer
DROPSHIP_ORDER_ID_FIELD=order_id

# --- Amazon Business API connector (الأتمتة الرسمية للشراء) ---
# اتركها فارغة = الوكيل يبقى في الوضع المساعَد. املأها بعد اعتماد حساب
# Amazon Business والحصول على وصول API. ثم اضبط المورد على mode='api' وAGENT_MODE=api.
AMAZON_BUSINESS_CLIENT_ID=
AMAZON_BUSINESS_CLIENT_SECRET=
AMAZON_BUSINESS_REFRESH_TOKEN=
AMAZON_BUSINESS_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_BUSINESS_API_BASE=
AMAZON_BUSINESS_MARKETPLACE_ID=

# --- AI layer ---
# Provider selector: stub | anthropic | openai
# "stub" works with NO API key and NO cost (default).
AI_PROVIDER=stub
# Filled only when AI_PROVIDER is anthropic/openai. Leave blank for stub.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Frontend ---
# Browser-visible base URL for the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
